---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import GameCard from '../../../components/GameCard.astro';
import '../../../styles/global.css';

export async function getStaticPaths({ paginate }) {
  const allGames = await getCollection('juegos');
  const categorias = [...new Set(allGames.map(j => j.data.categoria))];

  return categorias.flatMap((categoria) => {
    const juegosFiltrados = allGames.filter(j => j.data.categoria === categoria);
    return paginate(juegosFiltrados, { 
      params: { categoria }, 
      pageSize: 9 
    });
  });
}

const { categoria } = Astro.params;
const { page } = Astro.props;
---

<Layout title={`Juegos de ${categoria} | DropGames`}>
  <main class="contenedor-principal">
    <section class="seccion-recientes">
      <h2 class="titulo-seccion" style="text-transform: capitalize;">Categoría: {categoria}</h2>
      
      <div class="grid-videojuegos">
        {page.data.map((juego) => <GameCard juego={juego} />)}
      </div>

      <!-- Navegación estandarizada con tu Index -->
      <nav class="pagination-ui">
        {page.url.prev && <a href={page.url.prev} class="nav-btn">«</a>}
        
        <span class="page-numbers">{page.currentPage} de {page.lastPage}</span>
        
        {page.url.next && <a href={page.url.next} class="nav-btn">»</a>}
      </nav>
    </section>

    <!-- Sidebar Corregido -->
  <aside class="sidebar-top">
  <div class="sidebar-ads sidebar-ads-fija">
    <Anuncio type="banner-300" />
    <Anuncio type="banner-160-600" ocultarMovil />
  </div>
  </aside>
  </main>
</Layout>
